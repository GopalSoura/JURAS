# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for LOCAL development.
# On Vercel, set the same keys under Project -> Settings -> Environment Variables
# (Production). Vite inlines them at BUILD time, so changing one needs a redeploy.
# `.env.local` is gitignored, so local and Vercel settings never interfere.
# ---------------------------------------------------------------------------

# LOCAL DEVELOPMENT (npm run dev)
#   Leave VITE_WS_URL empty to run on the built-in hardware simulator.
#   To use this repo's FastAPI backend, point it at the backend port:
#     VITE_WS_URL=ws://localhost:8000/ws
#   In dev the Vite server proxies /api and /ws to VITE_BACKEND_URL
#   (default http://localhost:8000), so it works from localhost, a LAN IP, or a phone.
VITE_WS_URL=

# PRODUCTION BUILD (Vercel, etc.)
#   The page is served over HTTPS, so the backend MUST be https:// + wss://.
#   Browsers block ws:// (mixed content) from an https:// page.
#   VITE_API_URL is optional: when omitted it is derived from VITE_WS_URL.
#   Example with a Cloudflare tunnel:
#     VITE_WS_URL=wss://<backend-host>/ws
#     VITE_API_URL=https://<backend-host>
VITE_API_URL=

# Mapbox public access token. Also add your Vercel domain to the token's
# allowed URLs in the Mapbox account, otherwise the map tiles will be rejected.
VITE_MAPBOX_ACCESS_TOKEN=
